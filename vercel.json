{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/admin/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "lib/supabase.js",
      "use": "@vercel/static"
    },
    {
      "src": "js/api.js",
      "use": "@vercel/static"
    },
    {
      "src": "*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
